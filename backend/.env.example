# Copie para .env e preencha. O .env NÃO é versionado.

# waha (padrão, envia de verdade) | fake (só registra no log) — ver ADR-009
WHATSAPP_PROVIDER=waha
WHATSAPP_DESTINATARIO=

# WAHA: sobe junto com `docker compose up`; escaneie o QR em :3000 na primeira vez.
# No Docker o backend usa http://waha:3000 (definido no docker-compose.yml).
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

BCB_BASE_URL=https://www.bcb.gov.br/estabilidadefinanceira/consorciobd
DATABASE_URL=sqlite:///./data/execucoes.db
DATA_DIR=data
CATALOGO_TTL_HORAS=6

# Retentativa da coleta quando o BCB está fora do ar ou lento (esperas de 5 s, 15 s, …)
COLETA_TENTATIVAS=3
COLETA_ESPERA_INICIAL_SEGUNDOS=5

# false abre a janela do navegador — útil para depurar e demonstrar
PLAYWRIGHT_HEADLESS=true
LOG_LEVEL=INFO
